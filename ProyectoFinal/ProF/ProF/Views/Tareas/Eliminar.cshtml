@model Prof.Models.Tarea
@{
    ViewBag.Title = "Eliminar Tarea";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4><i class="fas fa-exclamation-triangle"></i> Confirmar Eliminación</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>¿Está seguro que desea eliminar esta tarea?</strong><br />
                        Esta acción no se puede deshacer.
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3">Nombre:</dt>
                        <dd class="col-sm-9"><strong>@Model.Nombre</strong></dd>

                        <dt class="col-sm-3">Descripción:</dt>
                        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Descripcion) ? "-" : Model.Descripcion)</dd>

                        <dt class="col-sm-3">Fecha Límite:</dt>
                        <dd class="col-sm-9">@Model.FechaLimite.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-3">Estado:</dt>
                        <dd class="col-sm-9">
                            <span class="badge badge-@(Model.Estado == Prof.Models.EstadoTarea.Pendiente ? "warning" : "success")">
                                @Model.Estado
                            </span>
                        </dd>

                        <dt class="col-sm-3">Prioridad:</dt>
                        <dd class="col-sm-9">
                            <span class="badge badge-@(Model.Prioridad == Prof.Models.PrioridadTarea.Alta ? "danger" : Model.Prioridad == Prof.Models.PrioridadTarea.Media ? "warning" : "secondary")">
                                @Model.Prioridad
                            </span>
                        </dd>
                    </dl>

                    @using (Html.BeginForm("Eliminar", "Tareas", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", Model.Id)

                        <hr />

                        <div class="form-group text-right">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash"></i> Sí, Eliminar
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>